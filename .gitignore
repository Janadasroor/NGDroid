# Gradle / Android build outputs
.gradle/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
output-metadata.json
baselineProfiles/
# Built release artifacts (local APKs, DMs)
app/release/

# Release signing key (decrypted from Actions secret in CI, local copy only)
release.keystore
*.jks
*.keystore

# Local SDK configuration (contains machine-specific absolute paths)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
.DS_Store

# Kotlin incremental state
.kotlin/

# Gradle daemon toolchain (machine-generated)
gradle/gradle-daemon-jvm.properties

# NDK / CMake generated
app/.cxx/

# Engine binaries are fetched at build time (see fetchViomatrixc);
# never commit local copies dropped into the default jniLibs dir.
app/src/main/jniLibs/

