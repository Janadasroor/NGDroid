<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- LLM API keys must never leave the device via cloud backup. -->
        <exclude domain="file" path="datastore/ngdroid_agent.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Keys are per-device secrets; re-enter them on the new phone. -->
        <exclude domain="file" path="datastore/ngdroid_agent.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
