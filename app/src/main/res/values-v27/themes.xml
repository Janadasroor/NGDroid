        <item name="android:statusBarColor">#1B1B1F</item>
        <item name="android:navigationBarColor">#1B1B1F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
